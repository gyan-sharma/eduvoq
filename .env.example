# Local development placeholders. Never commit real secrets.
DATABASE_URL=mysql://eduvoq:eduvoq@localhost:3306/eduvoq

# openssl rand -base64 32 — required in production (AUTH_SECRET ≥ 32 bytes)
AUTH_SECRET=
# Direct Next: http://localhost:3000 — via Caddy :80: http://localhost
# Production: https://www.eduvoq.com (cookie domain becomes .eduvoq.com)
AUTH_URL=http://localhost:3000
# Optional override; otherwise set automatically when AUTH_URL hosts eduvoq.com
AUTH_COOKIE_DOMAIN=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=hello@eduvoq.com

# local (pnpm dev / prod disk) | s3 (Compose MinIO)
FILE_DRIVER=local
FILE_LOCAL_ROOT=./storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eduvoq
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=info
