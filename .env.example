# Local development placeholders. Never commit real secrets.
#
# Production (neojn): copy to /var/www/eduvoq/.env
#   mode 0640, owner www-data:www-data
#   systemd EnvironmentFile=-/var/www/eduvoq/.env
# Fill merchant / OAuth / DB passwords on the droplet only.

# Dev Compose / pnpm: database `eduvoq`.
# Production host MySQL: mysql://eduvoq:<password>@127.0.0.1:3306/eduvoq_db
# Create user `eduvoq` + database `eduvoq_db` on neojn (least privilege, not root).
# Do not share tables with chessyi, schoolyi_db, or other host databases.
DATABASE_URL=mysql://eduvoq:eduvoq@localhost:3306/eduvoq

# openssl rand -base64 32 — required in production (AUTH_SECRET ≥ 32 bytes)
AUTH_SECRET=
# Direct Next: http://localhost:3000 — via Caddy :80: http://localhost
# Production: https://www.eduvoq.com (cookie domain becomes .eduvoq.com)
AUTH_URL=http://localhost:3000
# Optional override; otherwise set automatically when AUTH_URL hosts eduvoq.com
# Production: .eduvoq.com
AUTH_COOKIE_DOMAIN=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=hello@eduvoq.com
CONTACT_TO=hello@eduvoq.com

# local (pnpm dev / prod disk) | s3 (Compose MinIO)
# Production: local — do not run a MinIO container on neojn.
FILE_DRIVER=local
# Production: /var/www/eduvoq/storage (owner www-data, mode 0750, not world-readable)
FILE_LOCAL_ROOT=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eduvoq
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=info

# Bearer token for GET /api/cron. Leave empty locally to keep the route 401.
# Production: openssl rand -hex 32. Timer/crontab hits http://127.0.0.1:3110/api/cron
CRON_SECRET=

# Production systemd forces these even if unset here:
#   PORT=3110
#   HOSTNAME=127.0.0.1
#   NODE_OPTIONS=--max-old-space-size=384
# Production public URL (same as AUTH_URL): https://www.eduvoq.com
NEXT_PUBLIC_APP_URL=

TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Razorpay (India default). One-time orders only — no Subscriptions API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (international cards). INR paise. Checkout Session mode=payment only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
