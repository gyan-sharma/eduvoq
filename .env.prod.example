# Server defaults for /var/www/eduvoq/.env (copy via deploy bootstrap).
# Do not put real passwords in git.

DEPLOY_PATH=/var/www/eduvoq
DEPLOY_SYSTEMD_UNIT=eduvoq
PORT=3110
HOSTNAME=127.0.0.1
DEPLOY_SITE_DOMAIN=eduvoq.com
CADDY_SITE_NAME=eduvoq
PRODUCTION_PUBLIC_SITE_URL=https://eduvoq.com
NEXT_PUBLIC_APP_URL=https://eduvoq.com
AUTH_URL=https://eduvoq.com
AUTH_COOKIE_DOMAIN=.eduvoq.com
AUTH_SECRET=
CRON_SECRET=
DATABASE_URL=mysql://eduvoq:CHANGE_ME@127.0.0.1:3306/eduvoq_db
FILE_DRIVER=local
FILE_LOCAL_ROOT=/var/www/eduvoq/storage
EMAIL_FROM=hello@eduvoq.com
CONTACT_TO=hello@eduvoq.com
SMTP_HOST=smtp-pulse.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NODE_OPTIONS=--max-old-space-size=384
