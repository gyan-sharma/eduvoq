# Production site for host Caddy on neojn.
# Install: /etc/caddy/sites/eduvoq.caddy
# Host Caddyfile already imports /etc/caddy/sites/*.caddy
#
# Apex eduvoq.com is the live hostname until www A/CNAME also points at this droplet.
# Serve both names so flipping www DNS does not require another Caddy edit.

eduvoq.com, www.eduvoq.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3110
}
