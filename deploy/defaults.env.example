# Copy into `.env.local` (laptop) and `.env.prod` (server defaults) as needed.
# EduVoq on neojn — keep secrets out of git (repo .gitignore covers .env*).

# --- Clone & install path ---
# DEPLOY_PATH=/var/www/eduvoq

# Git clone URL. If unset, bootstrap uses GITHUB_REPO_SLUG (or git remote origin → GitHub).
# DEPLOY_GIT_URL=https://github.com/you/your-repo.git
# DEPLOY_GIT_URL=git@github.com:you/your-repo.git

# owner/repo on GitHub  -  required if DEPLOY_GIT_URL is unset and origin is not GitHub.
# Also required on the server when using GITHUB_TOKEN (HTTPS) bootstrap.
# GITHUB_REPO_SLUG=you/your-repo

# Prefer SSH clone URLs when resolving DEPLOY_GIT_URL (with deploy key on server).
# GITHUB_USE_SSH=1

# Bootstrap: HTTPS clone with a PAT (optional; do not commit real tokens).
# GITHUB_TOKEN=

# Server: private key path for git@github.com (see deploy/github-ssh-setup.sh, deploy/lib.sh GIT_SSH_COMMAND).
# GITHUB_DEPLOY_KEY_PATH=/var/www/app/.ssh/github_deploy_ed25519

# Default branch for `git reset --hard origin/<branch>` during update (default main).
# DEPLOY_GIT_BRANCH=main

# --- systemd ---
# Unit name: /etc/systemd/system/<name>.service (unique per app on one host).
# DEPLOY_SYSTEMD_UNIT=app

# Template under deploy/systemd/ (default app.service.in).
# DEPLOY_SYSTEMD_TEMPLATE=app.service.in

# Optional label for logs/docs (defaults to DEPLOY_SYSTEMD_UNIT).
# DEPLOY_APP_LABEL=myapp

# --- Ports (must match: APP_PORT laptop ↔ PORT in .env.prod ↔ Caddy reverse_proxy) ---
# APP_PORT=3020
# PORT=3020

# --- Caddy / public URL ---
# DEPLOY_SITE_DOMAIN=www.example.com
# PRODUCTION_PUBLIC_SITE_URL=https://www.example.com

# --- Multi-app on one server (see deploy/README.md  -  Several apps on one server) ---
# CADDY_SITE_FRAGMENTS=1
# CADDY_SITE_NAME=neojn   # fragment /etc/caddy/sites/<name>.caddy when master is import-only (see deploy/README.md)
# SKIP_CADDY_BOOTSTRAP=1
# DEPLOY_AUTO_CADDY_SYNC=1      # default: npm run deploy/update from Mac applies HTTPS Caddyfile when DEPLOY_SITE_DOMAIN is set
# DEPLOY_CADDY_APPLY_ON_SERVER_UPDATE=1   # default: server-native update.sh refreshes Caddy when root (uses DEPLOY_SITE_DOMAIN in merged .env)
# DEPLOY_VERIFY_HTTPS=1         # default: after update, curl public URL; warn if HTTPS fails (DNS/firewall/certs)
# DEPLOY_HTTPS_PROBE_DELAY=3    # seconds before HTTPS probe (Let’s Encrypt may need a moment)
# DEPLOY_CADDY_SYNC_MODE=skip   # force skip Caddy replace (shared multi-site Caddy hosts)
# DEPLOY_CADDY_SYNC_MODE=full   # explicit full sync
# DEPLOY_CADDY_TRUST_AUTO_OVERWRITE=0  # refuse replacing non-managed Caddyfiles (stricter than default)
# CADDY_FORCE_REPLACE_MASTER=1  # dangerous: allow bootstrap/sync-caddy to replace a non-empty master Caddyfile

# --- SSH from laptop ---
# Recommended: put your Ubuntu box in ~/.ssh/config (Host, HostName, User, IdentityFile) then set:
#   SSH_HOST=<same name as the Host line>   # e.g. my-ubuntu  -  OpenSSH then uses IdentityFile automatically
#   SSH_USER=deploy
# If you must keep SSH_HOST as an IP/DNS but the key is tied to a Host alias, set:
#   DEPLOY_SSH_DESTINATION=my-ubuntu
#   SSH_HOST=203.0.113.10   # optional, for your notes; connection uses DEPLOY_SSH_DESTINATION
# Full override: DEPLOY_SSH_DESTINATION=deploy@my-ubuntu
# Prefer SSH keys (no prompts): ssh-copy-id USER@HOST or paste your *.pub into ~/.ssh/authorized_keys on the server.
# Deploy reuses one SSH connection (ControlMaster) so you are not prompted on every scp/ssh step.
# DEPLOY_SSH_IDENTITY_FILE=~/.ssh/id_ed25519   # only if you do not use ~/.ssh/config IdentityFile
# DEPLOY_SSH_MUX=0                            # set to disable connection multiplexing (rare)
# DEPLOY_SSH_CONTROL_PATH=/path/to/mux_%C     # optional; default ~/.ssh/deploy_mux_%C
# DEPLOY_SSH_CONTROL_PERSIST=600              # seconds; background master after deploy exits
# DEPLOY_SSH_PUBLICKEY_ONLY=1                 # BatchMode: fail fast if key auth is not set up (no password prompts)
# Optional password auth (install sshpass): set SSHPASS or DEPLOY_SSH_PASSWORD for non-interactive ssh/scp.
# Do not commit real passwords; export in the shell or use a private, gitignored file.

# --- Deploy output (terminal) ---
# DEPLOY_PRETTY=1   # numbered steps + progress bar in update.sh / run.sh (set 0 for plain logs)
# DEPLOY_FORCE_COLOR=1   # ANSI colors when stdout is not a TTY (e.g. npm); also respects FORCE_COLOR

# --- Optional workflow ---
# DEPLOY_SYNC_CADDY=1
# SKIP_GIT_CHECK=1
# SKIP_DB_CHECK=1
# SKIP_DB_SEED=1
# DEPLOY_SERVER_UPDATE=1
# DEPLOY_MODE=local

# --- MySQL / Prisma ---
# DATABASE_URL=mysql://USER:PASS@127.0.0.1:3306/your_db

# --- Careers email (Resend) ---
# https://resend.com — create an API key and verify a sending domain (or use Resend test domain in development).
# From address (must be allowed for your Resend domain). Falls back to Resend onboarding sender if unset.
# Inbound team address for "new application" notifications.

# Careers / contact mail uses SMTP_* + FROM_EMAIL + EMAIL_RECIPIENT
# (optional legacy alias: CAREERS_NOTIFY_EMAIL falls back if EMAIL_RECIPIENT unset)

